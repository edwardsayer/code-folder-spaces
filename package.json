{
  "name": "code-folder-spaces",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "edwardsayer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "file explorer",
    "folder",
    "spaces",
    "navigation",
    "explorer"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-folder-spaces",
          "title": "%container.title%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "code-folder-spaces": [
        {
          "id": "codeFolderSpaces.pane1",
          "name": "%view.pane1.name%",
          "when": "!codeFolderSpaces.layoutReady || codeFolderSpaces.pane1.enabled",
          "contextualTitle": "%container.title%"
        },
        {
          "id": "codeFolderSpaces.pane2",
          "name": "%view.pane2.name%",
          "when": "codeFolderSpaces.mode == dual",
          "contextualTitle": "%container.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeFolderSpaces.pane1",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane2",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane3",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
