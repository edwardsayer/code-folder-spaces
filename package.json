{
  "name": "code-folder-spaces",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "edwardsayer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "file explorer",
    "folder",
    "spaces",
    "navigation",
    "explorer"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-folder-spaces",
          "title": "%container.title%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "code-folder-spaces": [
        { "id": "codeFolderSpaces.pane1", "name": "%view.pane1.name%", "when": "codeFolderSpaces.pane1.enabled", "contextualTitle": "%container.title%" },
        { "id": "codeFolderSpaces.pane2", "name": "%view.pane2.name%", "when": "codeFolderSpaces.pane2.enabled", "contextualTitle": "%container.title%" },
        { "id": "codeFolderSpaces.pane3", "name": "%view.pane3.name%", "when": "codeFolderSpaces.pane3.enabled", "contextualTitle": "%container.title%" },
        { "id": "codeFolderSpaces.pane4", "name": "%view.pane4.name%", "when": "codeFolderSpaces.pane4.enabled", "contextualTitle": "%container.title%" },
        { "id": "codeFolderSpaces.pane5", "name": "%view.pane5.name%", "when": "codeFolderSpaces.pane5.enabled", "contextualTitle": "%container.title%" },
        { "id": "codeFolderSpaces.pane6", "name": "%view.pane6.name%", "when": "codeFolderSpaces.pane6.enabled", "contextualTitle": "%container.title%" },
        { "id": "codeFolderSpaces.pane7", "name": "%view.pane7.name%", "when": "codeFolderSpaces.pane7.enabled", "contextualTitle": "%container.title%" },
        { "id": "codeFolderSpaces.pane8", "name": "%view.pane8.name%", "when": "codeFolderSpaces.pane8.enabled", "contextualTitle": "%container.title%" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeFolderSpaces.pane1",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane2",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane3",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane4",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane5",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane6",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane7",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      },
      {
        "view": "codeFolderSpaces.pane8",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      }
    ],
    "commands": [
      {
        "command": "codeFolderSpaces.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "codeFolderSpaces.addSpace",
        "title": "%command.addSpace.title%",
        "icon": "$(add)"
      },
      {
        "command": "codeFolderSpaces.removeSpace",
        "title": "%command.removeSpace.title%",
        "icon": "$(remove)"
      },
      {
        "command": "codeFolderSpaces.revealActiveFile",
        "title": "%command.revealActiveFile.title%",
        "icon": "$(target)"
      },
      {
        "command": "codeFolderSpaces.toggleFollowActiveFile",
        "title": "%command.toggleFollowActiveFile.title%",
        "icon": "$(eye)"
      },
      {
        "command": "codeFolderSpaces.expandLevel",
        "title": "%command.expandLevel.title%",
        "icon": "$(chevron-down)"
      },
      {
        "command": "codeFolderSpaces.setPreset",
        "title": "%command.setPreset.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "codeFolderSpaces.toggleMode",
        "title": "%command.toggleMode.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "codeFolderSpaces.filter",
        "title": "%command.filter.title%",
        "icon": "$(filter)"
      },
      {
        "command": "codeFolderSpaces.clearFilter",
        "title": "%command.clearFilter.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "codeFolderSpaces.setSort",
        "title": "%command.setSort.title%",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "codeFolderSpaces.drillDown",
        "title": "%command.drillDown.title%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codeFolderSpaces.drillUp",
        "title": "%command.drillUp.title%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codeFolderSpaces.switchRoot",
        "title": "%command.switchRoot.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codeFolderSpaces.renameSpace",
        "title": "%command.renameSpace.title%",
        "icon": "$(edit)"
      },
      { "command": "codeFolderSpaces.openEntry", "title": "%command.openEntry.title%" },
      { "command": "codeFolderSpaces.copyEntry", "title": "%command.copyEntry.title%" },
      { "command": "codeFolderSpaces.cutEntry", "title": "%command.cutEntry.title%" },
      { "command": "codeFolderSpaces.pasteEntries", "title": "%command.pasteEntries.title%" },
      { "command": "codeFolderSpaces.newFile", "title": "%command.newFile.title%" },
      { "command": "codeFolderSpaces.newFolder", "title": "%command.newFolder.title%" },
      { "command": "codeFolderSpaces.renameEntry", "title": "%command.renameEntry.title%" },
      { "command": "codeFolderSpaces.moveTo", "title": "%command.moveTo.title%" },
      { "command": "codeFolderSpaces.deleteEntry", "title": "%command.deleteEntry.title%" },
      { "command": "codeFolderSpaces.undoFileOperation", "title": "%command.undo.title%" },
      { "command": "codeFolderSpaces.revealInExplorer", "title": "%command.revealInExplorer.title%" },
      { "command": "codeFolderSpaces.revealFileInOS", "title": "%command.revealFileInOS.title%" },
      { "command": "codeFolderSpaces.openInTerminal", "title": "%command.openInTerminal.title%" },
      { "command": "codeFolderSpaces.findInFolder", "title": "%command.findInFolder.title%" },
      { "command": "codeFolderSpaces.copyFilePath", "title": "%command.copyFilePath.title%" },
      { "command": "codeFolderSpaces.copyRelativeFilePath", "title": "%command.copyRelativeFilePath.title%" },
      { "command": "codeFolderSpaces.pane.add", "title": "%command.pane.add.title%", "icon": "$(add)" },
      { "command": "codeFolderSpaces.pane.remove", "title": "%command.pane.remove.title%", "icon": "$(remove)" },
      { "command": "codeFolderSpaces.pane.resetLayout", "title": "%command.pane.resetLayout.title%" },
      { "command": "codeFolderSpaces.pane1.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane1.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane2.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane3.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane4.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane5.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane6.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane7.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane8.menu", "title": "%command.pane.menu.title%" },
      { "command": "codeFolderSpaces.pane2.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane3.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane4.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane5.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane6.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane7.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane8.toggleFollow", "title": "%command.pane.toggleFollow.title%" },
      { "command": "codeFolderSpaces.pane1.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane1.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" },
      { "command": "codeFolderSpaces.pane2.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane2.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" },
      { "command": "codeFolderSpaces.pane3.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane3.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" },
      { "command": "codeFolderSpaces.pane4.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane4.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" },
      { "command": "codeFolderSpaces.pane5.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane5.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" },
      { "command": "codeFolderSpaces.pane6.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane6.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" },
      { "command": "codeFolderSpaces.pane7.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane7.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" },
      { "command": "codeFolderSpaces.pane8.followOn", "title": "%command.pane.toggleFollow.title%", "icon": "$(link)" },
      { "command": "codeFolderSpaces.pane8.followOff", "title": "%command.pane.toggleFollow.title%", "icon": "$(debug-disconnect)" }
    ],
    "keybindings": [
      { "command": "codeFolderSpaces.newFile", "key": "ctrl+n", "when": "focusedView == codeFolderSpaces.pane1 && listFocus && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)" },
      { "command": "codeFolderSpaces.copyEntry", "key": "ctrl+c", "when": "focusedView == codeFolderSpaces.pane1 && listFocus && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)" },
      { "command": "codeFolderSpaces.cutEntry", "key": "ctrl+x", "when": "focusedView == codeFolderSpaces.pane1 && listFocus && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)" },
      { "command": "codeFolderSpaces.pasteEntries", "key": "ctrl+v", "when": "focusedView == codeFolderSpaces.pane1 && listFocus && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)" },
      { "command": "codeFolderSpaces.renameEntry", "key": "f2", "when": "focusedView == codeFolderSpaces.pane1 && listFocus && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)" },
      { "command": "codeFolderSpaces.deleteEntry", "key": "delete", "when": "focusedView == codeFolderSpaces.pane1 && listFocus && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)" },
      { "command": "codeFolderSpaces.undoFileOperation", "key": "ctrl+z", "when": "focusedView == codeFolderSpaces.pane1 && listFocus && isWorkspaceTrusted" }
    ],
    "menus": {
      "view/title": [
        { "command": "codeFolderSpaces.pane1.menu", "when": "view == codeFolderSpaces.pane1", "group": "navigation@0" },
        { "command": "codeFolderSpaces.pane2.menu", "when": "view == codeFolderSpaces.pane2", "group": "navigation@0" },
        { "command": "codeFolderSpaces.pane3.menu", "when": "view == codeFolderSpaces.pane3", "group": "navigation@0" },
        { "command": "codeFolderSpaces.pane4.menu", "when": "view == codeFolderSpaces.pane4", "group": "navigation@0" },
        { "command": "codeFolderSpaces.pane5.menu", "when": "view == codeFolderSpaces.pane5", "group": "navigation@0" },
        { "command": "codeFolderSpaces.pane6.menu", "when": "view == codeFolderSpaces.pane6", "group": "navigation@0" },
        { "command": "codeFolderSpaces.pane7.menu", "when": "view == codeFolderSpaces.pane7", "group": "navigation@0" },
        { "command": "codeFolderSpaces.pane8.menu", "when": "view == codeFolderSpaces.pane8", "group": "navigation@0" },
        {
          "command": "codeFolderSpaces.pane.add",
          "when": "view == codeFolderSpaces.pane1 && codeFolderSpaces.canAddPane",
          "group": "navigation@9"
        },
        {
          "command": "codeFolderSpaces.pane.remove",
          "when": "view == codeFolderSpaces.pane1 && codeFolderSpaces.canRemovePane",
          "group": "navigation@10"
        },
        {
          "command": "codeFolderSpaces.addSpace",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.refresh",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.revealActiveFile",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.toggleFollowActiveFile",
          "when": "view == codeFolderSpaces.pane1 && (!codeFolderSpaces.followActiveFile)",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.toggleFollowActiveFile",
          "when": "view == codeFolderSpaces.pane1 && (codeFolderSpaces.followActiveFile)",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.expandLevel",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.setPreset",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@3"
        },
        {
          "command": "codeFolderSpaces.toggleMode",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@4"
        },
        {
          "command": "codeFolderSpaces.filter",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@5"
        },
        {
          "command": "codeFolderSpaces.clearFilter",
          "when": "view == codeFolderSpaces.pane1 && (codeFolderSpaces.hasFilter)",
          "group": "navigation@6"
        },
        {
          "command": "codeFolderSpaces.setSort",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@7"
        },
        {
          "command": "codeFolderSpaces.drillUp",
          "when": "view == codeFolderSpaces.pane1 && (codeFolderSpaces.canDrillUp)",
          "group": "navigation@8"
        },
        {
          "command": "codeFolderSpaces.switchRoot",
          "when": "view == codeFolderSpaces.pane1",
          "group": "navigation@9"
        }
,
        {
          "command": "codeFolderSpaces.pane1.followOn",
          "when": "view == codeFolderSpaces.pane1 && codeFolderSpaces.pane1.hasParent && codeFolderSpaces.pane1.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane1.followOff",
          "when": "view == codeFolderSpaces.pane1 && codeFolderSpaces.pane1.hasParent && !codeFolderSpaces.pane1.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane2.followOn",
          "when": "view == codeFolderSpaces.pane2 && codeFolderSpaces.pane2.hasParent && codeFolderSpaces.pane2.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane2.followOff",
          "when": "view == codeFolderSpaces.pane2 && codeFolderSpaces.pane2.hasParent && !codeFolderSpaces.pane2.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane3.followOn",
          "when": "view == codeFolderSpaces.pane3 && codeFolderSpaces.pane3.hasParent && codeFolderSpaces.pane3.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane3.followOff",
          "when": "view == codeFolderSpaces.pane3 && codeFolderSpaces.pane3.hasParent && !codeFolderSpaces.pane3.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane4.followOn",
          "when": "view == codeFolderSpaces.pane4 && codeFolderSpaces.pane4.hasParent && codeFolderSpaces.pane4.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane4.followOff",
          "when": "view == codeFolderSpaces.pane4 && codeFolderSpaces.pane4.hasParent && !codeFolderSpaces.pane4.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane5.followOn",
          "when": "view == codeFolderSpaces.pane5 && codeFolderSpaces.pane5.hasParent && codeFolderSpaces.pane5.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane5.followOff",
          "when": "view == codeFolderSpaces.pane5 && codeFolderSpaces.pane5.hasParent && !codeFolderSpaces.pane5.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane6.followOn",
          "when": "view == codeFolderSpaces.pane6 && codeFolderSpaces.pane6.hasParent && codeFolderSpaces.pane6.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane6.followOff",
          "when": "view == codeFolderSpaces.pane6 && codeFolderSpaces.pane6.hasParent && !codeFolderSpaces.pane6.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane7.followOn",
          "when": "view == codeFolderSpaces.pane7 && codeFolderSpaces.pane7.hasParent && codeFolderSpaces.pane7.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane7.followOff",
          "when": "view == codeFolderSpaces.pane7 && codeFolderSpaces.pane7.hasParent && !codeFolderSpaces.pane7.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane8.followOn",
          "when": "view == codeFolderSpaces.pane8 && codeFolderSpaces.pane8.hasParent && codeFolderSpaces.pane8.follow",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.pane8.followOff",
          "when": "view == codeFolderSpaces.pane8 && codeFolderSpaces.pane8.hasParent && !codeFolderSpaces.pane8.follow",
          "group": "navigation@1"
        }      ],
      "view/item/context": [
        {
          "command": "codeFolderSpaces.drillDown",
          "when": "view == codeFolderSpaces.pane1 && viewItem == codeFolderSpaces.folder",
          "group": "inline@1"
        },
        {
          "command": "codeFolderSpaces.renameSpace",
          "when": "view == codeFolderSpaces.pane1 && viewItem == codeFolderSpaces.spaceRoot",
          "group": "inline@1"
        },
        {
          "command": "codeFolderSpaces.removeSpace",
          "when": "view == codeFolderSpaces.pane1 && viewItem == codeFolderSpaces.spaceRoot",
          "group": "inline@2"
        },
        { "command": "codeFolderSpaces.newFile", "when": "view == codeFolderSpaces.pane1 && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "1_modification@1" },
        { "command": "codeFolderSpaces.newFolder", "when": "view == codeFolderSpaces.pane1 && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "1_modification@2" },
        { "command": "codeFolderSpaces.renameEntry", "when": "view == codeFolderSpaces.pane1 && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)", "group": "1_modification@3" },
        { "command": "codeFolderSpaces.moveTo", "when": "view == codeFolderSpaces.pane1 && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)", "group": "1_modification@4" },
        { "command": "codeFolderSpaces.deleteEntry", "when": "view == codeFolderSpaces.pane1 && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)", "group": "1_modification@5" },
        { "command": "codeFolderSpaces.undoFileOperation", "when": "view == codeFolderSpaces.pane1 && isWorkspaceTrusted", "group": "1_modification@6" },
        { "command": "codeFolderSpaces.revealInExplorer", "when": "view == codeFolderSpaces.pane1 && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@1" },
        { "command": "codeFolderSpaces.revealFileInOS", "when": "view == codeFolderSpaces.pane1 && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@2" },
        { "command": "codeFolderSpaces.openInTerminal", "when": "view == codeFolderSpaces.pane1 && (viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@3" },
        { "command": "codeFolderSpaces.findInFolder", "when": "view == codeFolderSpaces.pane1 && (viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@4" },
        { "command": "codeFolderSpaces.copyFilePath", "when": "view == codeFolderSpaces.pane1 && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "3_clipboard@1" },
        { "command": "codeFolderSpaces.copyRelativeFilePath", "when": "view == codeFolderSpaces.pane1 && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "3_clipboard@2" }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codeFolderSpaces.spaces": {
          "type": "array",
          "default": [],
          "markdownDescription": "%configuration.spaces.description%",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "%configuration.spaces.path.description%"
                  },
                  "name": {
                    "type": "string",
                    "description": "%configuration.spaces.name.description%"
                  },
                  "icon": {
                    "type": "string",
                    "description": "%configuration.spaces.icon.description%"
                  },
                  "showFiles": {
                    "type": "boolean",
                    "description": "%configuration.spaces.showFiles.description%"
                  },
                  "include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "%configuration.spaces.include.description%"
                  },
                  "exclude": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "%configuration.spaces.exclude.description%"
                  }
                }
              }
            ]
          }
        },
        "codeFolderSpaces.view.showFiles": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showFiles.description%"
        },
        "codeFolderSpaces.openFilesIn": {
          "type": "string",
          "enum": ["current", "beside"],
          "default": "current",
          "enumDescriptions": ["%configuration.openFilesIn.current%", "%configuration.openFilesIn.beside%"],
          "description": "%configuration.openFilesIn.description%"
        },
        "codeFolderSpaces.followActiveFile": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.followActiveFile.description%"
        },
        "codeFolderSpaces.panes.count": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "%configuration.panes.count.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build:tests": "node esbuild.tests.mjs",
    "test:integration": "npm run build && npm run build:tests && vscode-test --config .vscode-test.mjs",
    "test:unit:watch": "vitest",
    "package:vsix": "node esbuild.mjs --production && vsce package",
    "check:project": "node scripts/check-project.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run check:project"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
