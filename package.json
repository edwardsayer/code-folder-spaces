{
  "name": "code-folder-spaces",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "edwardsayer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "file explorer",
    "folder",
    "spaces",
    "navigation",
    "explorer"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-folder-spaces",
          "title": "%container.title%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "code-folder-spaces": [
        {
          "id": "codeFolderSpaces.explorer",
          "name": "%view.explorer.name%",
          "contextualTitle": "%container.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeFolderSpaces.explorer",
        "contents": "%viewsWelcome.empty%",
        "when": "!codeFolderSpaces.hasSpaces"
      }
    ],
    "commands": [
      {
        "command": "codeFolderSpaces.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "codeFolderSpaces.addSpace",
        "title": "%command.addSpace.title%",
        "icon": "$(add)"
      },
      {
        "command": "codeFolderSpaces.removeSpace",
        "title": "%command.removeSpace.title%",
        "icon": "$(remove)"
      },
      {
        "command": "codeFolderSpaces.revealActiveFile",
        "title": "%command.revealActiveFile.title%",
        "icon": "$(target)"
      },
      {
        "command": "codeFolderSpaces.toggleFollowActiveFile",
        "title": "%command.toggleFollowActiveFile.title%",
        "icon": "$(eye)"
      },
      {
        "command": "codeFolderSpaces.expandLevel",
        "title": "%command.expandLevel.title%",
        "icon": "$(chevron-down)"
      },
      {
        "command": "codeFolderSpaces.setPreset",
        "title": "%command.setPreset.title%",
        "icon": "$(list-selection)"
      },
      {
        "command": "codeFolderSpaces.toggleMode",
        "title": "%command.toggleMode.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "codeFolderSpaces.filter",
        "title": "%command.filter.title%",
        "icon": "$(filter)"
      },
      {
        "command": "codeFolderSpaces.clearFilter",
        "title": "%command.clearFilter.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "codeFolderSpaces.setSort",
        "title": "%command.setSort.title%",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "codeFolderSpaces.drillDown",
        "title": "%command.drillDown.title%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codeFolderSpaces.drillUp",
        "title": "%command.drillUp.title%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codeFolderSpaces.switchRoot",
        "title": "%command.switchRoot.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codeFolderSpaces.renameSpace",
        "title": "%command.renameSpace.title%",
        "icon": "$(edit)"
      },
      { "command": "codeFolderSpaces.newFile", "title": "%command.newFile.title%" },
      { "command": "codeFolderSpaces.newFolder", "title": "%command.newFolder.title%" },
      { "command": "codeFolderSpaces.renameEntry", "title": "%command.renameEntry.title%" },
      { "command": "codeFolderSpaces.moveTo", "title": "%command.moveTo.title%" },
      { "command": "codeFolderSpaces.deleteEntry", "title": "%command.deleteEntry.title%" },
      { "command": "codeFolderSpaces.undoFileOperation", "title": "%command.undo.title%" },
      { "command": "codeFolderSpaces.revealInExplorer", "title": "%command.revealInExplorer.title%" },
      { "command": "codeFolderSpaces.revealFileInOS", "title": "%command.revealFileInOS.title%" },
      { "command": "codeFolderSpaces.openInTerminal", "title": "%command.openInTerminal.title%" },
      { "command": "codeFolderSpaces.findInFolder", "title": "%command.findInFolder.title%" },
      { "command": "codeFolderSpaces.copyFilePath", "title": "%command.copyFilePath.title%" },
      { "command": "codeFolderSpaces.copyRelativeFilePath", "title": "%command.copyRelativeFilePath.title%" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeFolderSpaces.addSpace",
          "group": "navigation@1"
        },
        {
          "command": "codeFolderSpaces.refresh",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.revealActiveFile",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.toggleFollowActiveFile",
          "when": "!codeFolderSpaces.followActiveFile",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.toggleFollowActiveFile",
          "when": "codeFolderSpaces.followActiveFile",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.expandLevel",
          "group": "navigation@2"
        },
        {
          "command": "codeFolderSpaces.setPreset",
          "group": "navigation@3"
        },
        {
          "command": "codeFolderSpaces.toggleMode",
          "group": "navigation@4"
        },
        {
          "command": "codeFolderSpaces.filter",
          "group": "navigation@5"
        },
        {
          "command": "codeFolderSpaces.clearFilter",
          "when": "codeFolderSpaces.hasFilter",
          "group": "navigation@6"
        },
        {
          "command": "codeFolderSpaces.setSort",
          "group": "navigation@7"
        },
        {
          "command": "codeFolderSpaces.drillUp",
          "when": "codeFolderSpaces.canDrillUp",
          "group": "navigation@8"
        },
        {
          "command": "codeFolderSpaces.switchRoot",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "codeFolderSpaces.drillDown",
          "when": "view == codeFolderSpaces.explorer && viewItem == codeFolderSpaces.folder",
          "group": "inline@1"
        },
        {
          "command": "codeFolderSpaces.renameSpace",
          "when": "view == codeFolderSpaces.explorer && viewItem == codeFolderSpaces.spaceRoot",
          "group": "inline@1"
        },
        {
          "command": "codeFolderSpaces.removeSpace",
          "when": "view == codeFolderSpaces.explorer && viewItem == codeFolderSpaces.spaceRoot",
          "group": "inline@2"
        },
        { "command": "codeFolderSpaces.newFile", "when": "view == codeFolderSpaces.explorer && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "1_modification@1" },
        { "command": "codeFolderSpaces.newFolder", "when": "view == codeFolderSpaces.explorer && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "1_modification@2" },
        { "command": "codeFolderSpaces.renameEntry", "when": "view == codeFolderSpaces.explorer && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)", "group": "1_modification@3" },
        { "command": "codeFolderSpaces.moveTo", "when": "view == codeFolderSpaces.explorer && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)", "group": "1_modification@4" },
        { "command": "codeFolderSpaces.deleteEntry", "when": "view == codeFolderSpaces.explorer && isWorkspaceTrusted && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder)", "group": "1_modification@5" },
        { "command": "codeFolderSpaces.undoFileOperation", "when": "view == codeFolderSpaces.explorer && isWorkspaceTrusted", "group": "1_modification@6" },
        { "command": "codeFolderSpaces.revealInExplorer", "when": "view == codeFolderSpaces.explorer && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@1" },
        { "command": "codeFolderSpaces.revealFileInOS", "when": "view == codeFolderSpaces.explorer && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@2" },
        { "command": "codeFolderSpaces.openInTerminal", "when": "view == codeFolderSpaces.explorer && (viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@3" },
        { "command": "codeFolderSpaces.findInFolder", "when": "view == codeFolderSpaces.explorer && (viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "2_navigation@4" },
        { "command": "codeFolderSpaces.copyFilePath", "when": "view == codeFolderSpaces.explorer && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "3_clipboard@1" },
        { "command": "codeFolderSpaces.copyRelativeFilePath", "when": "view == codeFolderSpaces.explorer && (viewItem == codeFolderSpaces.file || viewItem == codeFolderSpaces.folder || viewItem == codeFolderSpaces.spaceRoot)", "group": "3_clipboard@2" }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codeFolderSpaces.spaces": {
          "type": "array",
          "default": [],
          "markdownDescription": "%configuration.spaces.description%",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "%configuration.spaces.path.description%"
                  },
                  "name": {
                    "type": "string",
                    "description": "%configuration.spaces.name.description%"
                  },
                  "icon": {
                    "type": "string",
                    "description": "%configuration.spaces.icon.description%"
                  },
                  "showFiles": {
                    "type": "boolean",
                    "description": "%configuration.spaces.showFiles.description%"
                  },
                  "include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "%configuration.spaces.include.description%"
                  },
                  "exclude": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "%configuration.spaces.exclude.description%"
                  }
                }
              }
            ]
          }
        },
        "codeFolderSpaces.view.showFiles": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showFiles.description%"
        },
        "codeFolderSpaces.followActiveFile": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.followActiveFile.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build:tests": "node esbuild.tests.mjs",
    "test:integration": "npm run build && npm run build:tests && vscode-test --config .vscode-test.mjs",
    "test:unit:watch": "vitest",
    "package:vsix": "node esbuild.mjs --production && vsce package",
    "check:project": "node scripts/check-project.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run check:project"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "mocha": "^10.8.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
